function normalizeDueDate(value) {
  value = String(value || '').trim();

  // No due date
  if (!value || value === 'No due date') {
    return 'No due date';
  }

  // Already normalised YYYY-MM-DD
  const dateOnlyMatch = value.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (dateOnlyMatch) {
    return value;
  }

  // SGT wall-time format produced by formatDueDateSmart ("yyyy-MM-dd HH:mm").
  // Parse it explicitly as SGT instead of relying on the script timezone.
  const wallMatch = value.match(/^(\d{4})-(\d{2})-(\d{2})[ T](\d{1,2}):(\d{2})/);
  if (wallMatch) {
    const d = new Date(Date.UTC(
      Number(wallMatch[1]),
      Number(wallMatch[2]) - 1,
      Number(wallMatch[3]),
      Number(wallMatch[4]) - CONFIG.tzOffsetHours,
      Number(wallMatch[5])
    ));
    if (!isNaN(d.getTime())) {
      return Utilities.formatDate(d, CONFIG.tz, 'yyyy-MM-dd');
    }
  }

  // Full ISO string (Classroom commonly returns these)
  if (value.includes('T')) {
    const d = new Date(value);

    if (!isNaN(d.getTime())) {
      return Utilities.formatDate(d, CONFIG.tz, 'yyyy-MM-dd');
    }
  }

  // Generic parse attempt
  const d = new Date(value);

  if (!isNaN(d.getTime())) {
    return Utilities.formatDate(d, CONFIG.tz, 'yyyy-MM-dd');
  }

  // Fallback for custom date strings
  const parsed = parseDate(value);

  if (parsed && !isNaN(parsed.getTime())) {
    return Utilities.formatDate(parsed, CONFIG.tz, 'yyyy-MM-dd');
  }

  // Final fallback
  return value;
}

function normalizeDisplayDue(value) {
  if (!value) return 'No due date';

  if (value instanceof Date && !isNaN(value.getTime())) {
    const datePart = Utilities.formatDate(value, CONFIG.tz, 'yyyy-MM-dd');
    const timePart = Utilities.formatDate(value, CONFIG.tz, 'HH:mm');
    return timePart === '23:59' || timePart === '00:00'
      ? datePart
      : `${datePart} ${timePart}`;
  }

  const str = String(value).trim();
  if (!str || str === 'No due date') return 'No due date';

  // Already formatted in SGT by formatDueDateSmart
  if (/^\d{4}-\d{2}-\d{2}( \d{2}:\d{2})?$/.test(str)) {
    return str;
  }

  const d = new Date(str);
  if (!isNaN(d.getTime())) {
    const datePart = Utilities.formatDate(d, CONFIG.tz, 'yyyy-MM-dd');
    const timePart = Utilities.formatDate(d, CONFIG.tz, 'HH:mm');
    return timePart === '23:59' ? datePart : `${datePart} ${timePart}`;
  }

  return str;
}
